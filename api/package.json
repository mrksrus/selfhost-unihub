{
  "name": "unihub-api",
  "private": true,
  "version": "0.19.0",
  "description": "UniHub API Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.js",
    "test:recovery": "npm run build && node scripts/test-recovery.cjs",
    "test:ci": "npm run build && node scripts/test-recovery.cjs --all"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ical.js": "2.2.1",
    "imapflow": "2.1.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "3.9.16",
    "mysql2": "3.23.1",
    "nodemailer": "^9.0.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "semver": "^7.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
